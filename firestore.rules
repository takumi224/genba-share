rules_version = '2';
// ============================================================
//  データベース（Firestore）のルール
//  ・新規登録した人は「承認待ち」になり、何も見られない
//  ・管理者が「承認」した人だけが現場データを見る・書くことができる
//  ・現場の削除と利用者の承認は管理者だけ
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function approved() {
      return signedIn()
        && exists(myProfilePath())
        && get(myProfilePath()).data.status == 'approved';
    }
    function isAdmin() {
      return approved() && get(myProfilePath()).data.role == 'admin';
    }

    // 利用者情報
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 本人が新規登録するときは、必ず「承認待ち・一般」でしか作れない
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'role', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email;
      // 承認・停止・権限変更は管理者だけ
      allow update, delete: if isAdmin();
    }

    // 現場情報
    match /sites/{siteId} {
      allow read, create, update: if approved();
      allow delete: if isAdmin();
    }

    // それ以外はすべて禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
